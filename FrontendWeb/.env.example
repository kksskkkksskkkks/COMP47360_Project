# Copy this to .env and point it at your real Spring backend
VITE_API_BASE_URL=http://localhost:8080/api

# Images are relative paths (e.g. images/park/dante-park.jpg) and need the
# backend's site root prefixed. If left empty, it defaults to
# VITE_API_BASE_URL with the trailing /api stripped off, so you usually
# don't need to set this separately.
VITE_ASSET_BASE_URL=
